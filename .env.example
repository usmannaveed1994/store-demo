# ---------------------------------------------------------------------------
# Prisma Postgres
# ---------------------------------------------------------------------------
# Create a database at https://console.prisma.io, then copy its connection
# string here. It looks like:
#   postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Clerk
# ---------------------------------------------------------------------------
# Clerk Dashboard -> Configure -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk Dashboard -> Configure -> Webhooks -> <your endpoint> -> Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=""

# Routes Clerk renders when a signed-out visitor needs to authenticate.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Where Clerk returns users once the flow completes.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Only needed while `ENABLE_STRIPE` in `lib/checkout/config.ts` is `true`. The
# default manual flow (advance payment / cash on delivery) never reads them.

# Dashboard -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=""

# Dashboard -> Developers -> Webhooks -> <your endpoint> -> Signing secret
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# Absolute origin used for Stripe's success/cancel URLs and for the product link
# in Instagram captions. Optional locally: the request origin is used when this is
# empty. Set it behind a proxy or on previews.
APP_URL=""

# ---------------------------------------------------------------------------
# Vercel Blob (admin product images)
# ---------------------------------------------------------------------------
# Vercel Dashboard -> Storage -> <your blob store> -> .env.local -> token.
# Required for the product form's image uploader; the rest of the admin area
# works without it. On Vercel, connecting the store injects this automatically.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Instagram (admin "Post" button on the products list)
# ---------------------------------------------------------------------------
# Meta app with the Instagram Content Publishing permission
# (`instagram_content_publish`), plus a professional IG account linked to a
# Facebook page. Dashboard -> Instagram API setup with Facebook login -> token.
# The token is long-lived (~60 days); refresh it before the post button starts
# answering 401. `GET /api/instagram` (admin only) checks both values.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# PostHog
# ---------------------------------------------------------------------------
# Public browser analytics configuration.
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="https://your-posthog-host"
